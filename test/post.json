{
  "method": "POST",
  "defaultTests": {
    "authentication": true,
    "securityMisconfiguration": true,
    "injection": true,
    "exceptionHandling": true,
    "logging": true
  },
  "endpoints": [
    {
      "path": "/api/items",
      "description": "Create a new item",
      "authMode": "public"
    }
  ],
  "accessControl": {
    "enabled": false,
    "authorizedTokenEnv": "VIBESHIELD_ADMIN_TOKEN",
    "unauthorizedTokenEnv": "VIBESHIELD_USER_TOKEN",
    "endpoints": []
  },
  "cryptographicHashing": {
    "enabled": false,
    "checks": {
      "passwordHashingAlgorithm": false,
      "uniqueSaltPerPassword": false,
      "passwordNotStoredInPlaintext": false,
      "passwordHashNotReturnedInResponse": false,
      "passwordNotExposedInLogs": false
    },
    "endpoints": []
  }
}