{
  "method": "GET",

  "defaultTests": {
    "authentication": true,
    "securityMisconfiguration": true,
    "injection": true,
    "exceptionHandling": true
  },

  "endpoints": [
    {
      "path": "/your/first/get/endpoint",
      "description": "First custom GET endpoint",
      "authMode": "protected"
    },
    {
      "path": "/your/second/get/endpoint",
      "description": "Second custom GET endpoint",
      "authMode": "public"
    }
  ],

  "accessControl": {
    "enabled": true,

    "authorizedTokenEnv": "VIBESHIELD_ADMIN_TOKEN",
    "unauthorizedTokenEnv": "VIBESHIELD_USER_TOKEN",

    "endpoints": [
      {
        "path": "/your/protected/get/endpoint",
        "expectedAuthorizedStatus": [200],
        "expectedUnauthorizedStatus": [401, 403]
      },
      {
        "path": "/your/another/protected/endpoint",
        "expectedAuthorizedStatus": [200],
        "expectedUnauthorizedStatus": [401, 403]
      }
    ]
  }
}
